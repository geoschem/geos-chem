# Normalize line endings to LF for text files by default.
# This repo is built and run on Linux/HPC clusters, so CRLF endings in
# scripts/source break shebangs, Fortran preprocessing, and compilation.
* text=auto eol=lf

# Binary assets — never diff/merge as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.nc binary
*.nc4 binary

# GitHub language detection (Linguist) overrides.
# The .H files are Fortran include files pulled into .F90 sources with
# #include.  Without this, GitHub counts them as C, and CodeQL default
# setup then tries (and fails) to run a C/C++ analysis.
*.H linguist-language=Fortran

# Run-directory templates for the carbon simulation end in ".carbon",
# which GitHub mistakes for the Carbon programming language.
*.carbon linguist-detectable=false
