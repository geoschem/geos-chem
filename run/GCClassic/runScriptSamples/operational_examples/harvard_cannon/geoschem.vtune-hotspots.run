#!/bin/bash

#SBATCH -c 48
#SBATCH -N 1
#SBATCH -t 0-1:00
#SBATCH --exclusive
#SBATCH -p huce_cascade,shared
#SBATCH --mem=18000
#SBATCH --mail-type=END

###############################################################################
### Sample GEOS-Chem Classic run script for Harvard Cannon (using SLURM).
### Profiles GEOS-Chem with the Intel VTune "hotspots" analysis.
###
### Each run's VTune result (rNNNhs) is moved, along with GC.log,
### gcclassic_timers.json, OutputDir/*.nc*, and a copy of Restarts/*.nc*,
### into a new folder named vtune_rNNNhs.  These reports are then written
### to that folder (tab-separated, despite the .csv extension):
###
###   rNNNhs.summary.txt              : Elapsed, CPU, spin, overhead time
###   rNNNhs.hotspots.by-func.csv     : CPU time per function
###   rNNNhs.hotspots.by-line.csv     : CPU time per source line
###   rNNNhs.hotspots.by-thread.csv   : CPU time per thread
###   rNNNhs.topdown-master.csv       : Call tree of the master thread
###
### NOTE: The vtune executable must be in your PATH when you submit
### this script.
###
### If you are running a nested-grid simulation at fine resolution, you
### will likely need to request additional memory, cores, and time.
### Also allow time for VTune to finalize its result and write the
### reports after GEOS-Chem finishes.
###
### -c           : Requests this many cores
### -N           : Requests a single node
### --mem        : Requests this amount of memory in MB
### -p           : Requests these partitions where the job can run
### -t           : Requests time for the job (days-hours:minutes)
###  --exclusive : Reserves entire nodes (i.e. to prevent backfilling jobs)
###############################################################################

# Load the GNU 12.2.0 environment
source CodeDir/run/runScriptSamples/operational_examples/harvard_cannon/gcclassic.gcc12_cannon_rocky.env

# Set the proper # of threads for OpenMP
# SLURM_CPUS_PER_TASK ensures this matches the number you set with -c above
export OMP_NUM_THREADS=$SLURM_CPUS_PER_TASK

# GEOS-Chem log file
log=GC.log

# Pick the next VTune result number ourselves.  VTune cannot report it
# in advance, and after rNNNhs is moved to vtune_rNNNhs its own
# auto-numbering would start over at r000hs.
last=$(ls -d r[0-9][0-9][0-9]hs vtune_r[0-9][0-9][0-9]hs 2>/dev/null \
       | grep -o '[0-9]\{3\}' | sort -n | tail -1)
if [[ -z "${last}" ]]; then
    expt="r000hs"
else
    expt=$(printf "r%03dhs" $(( 10#${last} + 1 )))
fi

# Run GEOS-Chem and collect hotspot information with Intel VTune
srun -c $OMP_NUM_THREADS time -p \
     vtune -collect hotspots -r ${expt} -- ./gcclassic >> ${log} 2>&1
rc=$?

# Do not rely on vtune passing on the exit code from gcclassic:
# also treat the run as failed if GEOS-Chem did not reach its end
if ! grep -q "E N D   O F   G E O S -- C H E M" ${log}; then
    [[ ${rc} -eq 0 ]] && rc=1
fi
echo '===> Run ended at' `date` >> ${log}

# Move the VTune result and GEOS-Chem output into one folder per result
dest="vtune_${expt}"
mkdir -p ${dest}/OutputDir
mkdir -p ${dest}/Restarts
mv ${expt} ${dest}/
mv OutputDir/*.nc* ${dest}/OutputDir/ 2>/dev/null
cp Restarts/*.nc* ${dest}/Restarts/ 2>/dev/null
mv ${log} gcclassic_timers.json ${dest}/ 2>/dev/null

# Generate reports from the moved VTune result.  Run them one at a
# time: two reports on the same result at once can fail.
res="${dest}/${expt}"
if [[ -d "${res}" ]]; then
    vtune -report summary -r ${res} -format text \
          -report-output ${dest}/${expt}.summary.txt
    vtune -report hotspots -r ${res} -format csv -csv-delimiter tab \
          -report-output ${dest}/${expt}.hotspots.by-func.csv
    vtune -report hotspots -r ${res} -group-by source-line \
          -format csv -csv-delimiter tab \
          -report-output ${dest}/${expt}.hotspots.by-line.csv

    # Per-thread totals, and the master thread's call tree (used to find
    # which parallel loops make the master thread wait).  NOTE: Under
    # GNU OpenMP all threads may be named "gcclassic (TID: ...)", so
    # this picks the busiest such thread, which is usually (but not
    # always) the master thread.  Check the by-thread report.
    vtune -report hotspots -r ${res} -group-by thread \
          -format csv -csv-delimiter tab \
          -report-output ${dest}/${expt}.hotspots.by-thread.csv
    master=$(awk -F'\t' 'NR>1 && $1 ~ /^gcclassic \(TID/ {print $1; exit}' \
             ${dest}/${expt}.hotspots.by-thread.csv)
    if [[ -n "${master}" ]]; then
        vtune -report top-down -r ${res} -filter "thread=${master}" \
              -format csv -csv-delimiter tab \
              -report-output ${dest}/${expt}.topdown-master.csv
    else
        echo "Master thread not found; skipping top-down report" >&2
    fi
else
    echo "VTune result ${res} not found; skipping reports" >&2
fi

# Exit with the return code from the GEOS-Chem run
exit ${rc}
