# Environment file for GCHP on HX2, Imperial College London (Slurm)
# EasyBuild toolchain foss-2024a: GCC 13.3.0, Open MPI 5.0.3, ESMF 8.7.0
# Use the same file to build and to run GCHP.
module purge
module load ESMF/8.7.0-foss-2024a
module load UDUNITS/2.2.28-GCCcore-13.3.0
module load CMake/3.29.3-GCCcore-13.3.0

# Also tested: foss-2025b (GCC 14.3.0, Open MPI 5.0.8, ESMF 8.9.0).
# To use it, replace the three "module load" lines above with these
# and rebuild GCHP:
#module load ESMF/8.9.0-foss-2025b
#module load UDUNITS/2.2.28-GCCcore-14.3.0
#module load CMake/3.31.8-GCCcore-14.3.0
