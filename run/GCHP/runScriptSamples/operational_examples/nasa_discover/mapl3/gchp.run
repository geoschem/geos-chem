#!/bin/bash

# For discover
#SBATCH --time 00:30:00
#SBATCH --nodes=1 --ntasks-per-node=6
#SBATCH --mem=60G
#SBATCH --job-name=gchp.run
#SBATCH --constraint=mil
#SBATCH --account=s1043
#SBATCH --qos=debug
##SBATCH -o gchp.%j.log
##SBATCH -e gchp.%j.log

# If a subsequent command fails, treat it as fatal (don't continue)
set -e

# For remainder of script, echo commands to the job's log file
#set -x

# Unlimit resources to prevent OS killing GCHP due to resource usage/
# Alternatively you can put this in your environment file.
ulimit -c 0                  # coredumpsize
ulimit -l unlimited          # memorylocked
ulimit -u 50000              # maxproc
ulimit -v unlimited          # vmemoryuse
ulimit -s unlimited          # stacksize

source gchp.env

# Print loaded modules
module list     

# Define log name to include simulation start date
cap_str=$(cat cap_restart.yaml)
start_str=${cap_str:10:16}
log=gchp.${start_str}z.log
# Other log options
#log=gchp.${SLURM_JOB_ID}.log
#log=gchp.${start_str}z.${SLURM_JOB_ID}.log

# Get grid resolution
N=$(awk '/^[[:space:]]*im_world:/ {print $2}' gchp.yaml)

# Clean up restarts if last run crashed
rm -f ./Restarts/gcchem*

# Update config files, set restart symlink, and do sanity checks
# ewl: comment this out for mapl3
#source setCommonRunSettings.sh > ${log}

# Comment these out for ctmEnv run
#source setRestartLink.sh >> ${log}
#source checkRunSettings.sh >> ${log}

# Run GCHP and evenly distribute tasks across nodes
coreCount=$(( SLURM_JOB_NUM_NODES * SLURM_NTASKS_PER_NODE ))
planeCount=$(( coreCount / SLURM_JOB_NUM_NODES ))
if [[ $(( coreCount % SLURM_JOB_NUM_NODES )) > 0 ]]; then
    planeCount=$(( planeCount + 1 ))
fi

# Turn off exit if command fails to allow script to finish if GCHP exits early
set +e

# Run GCHP
mpirun -np ${coreCount} ./gchp cap.yaml > "${log}"

# Rename mid-run checkpoint files, if any, unless time in filename corresponds
# to run start time (duplicate with initial restart file)
chkpnts=$(ls Restarts)
for chkpnt in ${chkpnts}
do
    if [[ "$chkpnt" == *"gcchem_internal_checkpoint."* ]]; then
       chkpnt_time=${chkpnt:27:13}
       if [[ "${chkpnt_time}" != "${start_str:0:13}" ]]; then
          new_chkpnt=./Restarts/GEOSChem.Restart.${chkpnt_time}z.c${N}.nc4
          mv ./Restarts/${chkpnt} ${new_chkpnt}
       fi
    fi
done

# If new start time in cap_restart is okay, rename end restart file
# and update restart symlink
new_cap_str=$(cat cap_restart.yaml)
new_start_str=${new_cap_str:10:16}
if [[ "${new_start_str}" = "${start_str}" || "${new_start_str}" = "" ]]; then
   echo "ERROR: GCHP failed to run to completion. Check the log file for more information."
   exit 1
else
    [ -e ./Restarts/gcchem_internal_checkpoint ] && \
	mv ./Restarts/gcchem_internal_checkpoint \
	   Restarts/GEOSChem.Restart.${new_start_str:0:13}z.c${N}.nc4
    #source setRestartLink.sh
fi

# Remove any remaining checkpoints that are not renamed
rm -f ./Restarts/gcchem*
